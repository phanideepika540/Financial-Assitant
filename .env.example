OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash
SESSION_SECRET=replace-with-a-random-secret-for-stable-sessions
# For PostgreSQL (for example, AWS RDS), set this to your private connection URL.
# If unset, local development uses data/finance_assistant.sqlite3.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/finance_assistant?sslmode=require
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=ai-finance-assistant
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
TAVILY_API_KEY=your-tavily-api-key
